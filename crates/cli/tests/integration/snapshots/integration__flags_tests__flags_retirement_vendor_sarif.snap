{
  "$schema": "https://raw.githubusercontent.com/oasis-tcs/sarif-spec/main/sarif-2.1/schema/sarif-schema-2.1.0.json",
  "version": "2.1.0",
  "runs": [
    {
      "tool": {
        "driver": {
          "name": "fallow",
          "version": "[VERSION]",
          "informationUri": "https://github.com/fallow-rs/fallow",
          "rules": [
            {
              "id": "fallow/feature-flag",
              "shortDescription": {
                "text": "Feature flag pattern detected"
              },
              "helpUri": "https://docs.fallow.tools/cli/flags",
              "defaultConfiguration": {
                "level": "note"
              }
            },
            {
              "id": "fallow/flag-retirement-candidate",
              "shortDescription": {
                "text": "Feature flag is a retirement candidate"
              },
              "fullDescription": {
                "text": "The evidence shows that the flag can be retired. A person decides; Fallow does not remove code."
              },
              "helpUri": "https://docs.fallow.tools/cli/flags#retirement-report",
              "defaultConfiguration": {
                "level": "note"
              }
            }
          ]
        }
      },
