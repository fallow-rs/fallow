{
  "name": "fallow-repo-tools",
  "private": true,
  "type": "module",
  "scripts": {
    "commitlint": "node scripts/assert-local-resolution.mjs @commitlint/cli && commitlint",
    "verify": "node scripts/verify-repo.mjs --fast",
    "verify:fast": "node scripts/verify-repo.mjs --fast",
    "verify:full": "node scripts/verify-repo.mjs --full",
    "generate:contracts": "node scripts/generate-all.mjs",
    "generate:contracts:check": "node scripts/generate-all.mjs --check",
    "generate:all": "node scripts/generate-all.mjs",
    "generate:all:check": "node scripts/generate-all.mjs --check",
    "generate:agent-adapters": "node scripts/generate-agent-adapters.mjs",
    "check:agent-adapters": "node scripts/generate-agent-adapters.mjs --check",
    "check:knowledge-architecture": "node scripts/check-knowledge-architecture.mjs",
    "check:contract-surfaces": "node scripts/check-contract-surfaces.mjs --github-actions .github/workflows/ci.yml",
    "check:ci-summary-rows": "node scripts/check-ci-summary-rows.mjs",
    "check:crate-boundaries": "node scripts/check-crate-boundaries.mjs",
    "scaffold:analyzer": "node scripts/scaffold-analyzer-plan.mjs",
    "conformance:public-smoke": "node scripts/public-smoke-conformance.mjs",
    "conformance:semantic-clones": "node scripts/semantic-clone-conformance.mjs",
    "conformance:semantic-clones:candle": "node scripts/semantic-clone-candle-conformance.mjs",
    "check:semantic-clone-conformance": "node scripts/semantic-clone-conformance.mjs --check",
    "check:similar-code-sidecar-audit": "node scripts/check-similar-code-sidecar-audit.mjs",
    "test:semantic-clone-conformance": "node --test scripts/semantic-clone-conformance.test.mjs",
    "type-aware:corpus": "node scripts/type-aware-corpus.mjs",
    "test:type-aware-corpus": "node --test scripts/type-aware-corpus.test.mjs",
    "smoke:styling-corpus": "node scripts/styling-corpus-smoke.mjs",
    "smoke:styling-prs": "node scripts/styling-pr-smoke.mjs",
    "lint:js": "node scripts/assert-local-resolution.mjs oxlint && oxlint --disable-nested-config npm benchmarks crates/napi .github/scripts editors/vscode/src viz-frontend/src scripts tools/type-aware-sidecar commitlint.config.mjs",
    "fmt:js": "node scripts/assert-local-resolution.mjs oxfmt && oxfmt --disable-nested-config npm benchmarks crates/napi .github/scripts editors/vscode/src viz-frontend/src scripts tools/type-aware-sidecar commitlint.config.mjs",
    "fmt:js:check": "node scripts/assert-local-resolution.mjs oxfmt && oxfmt --check --disable-nested-config npm benchmarks crates/napi .github/scripts editors/vscode/src viz-frontend/src scripts tools/type-aware-sidecar commitlint.config.mjs"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "overrides": {
    "typescript": "7.0.2"
  },
  "devDependencies": {
    "@commitlint/cli": "21.2.2",
    "@commitlint/config-conventional": "21.2.2",
    "@tanstack/intent": "0.3.6",
    "oxfmt": "0.63.0",
    "oxlint": "1.78.0"
  }
}
