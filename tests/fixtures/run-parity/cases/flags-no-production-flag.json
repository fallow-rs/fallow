{
  "name": "flags-no-production-flag",
  "files": {
    ".fallowrc.json": "{\"production\":true}",
    "package.json": "{}"
  },
  "inputs": {
    "cli": {
      "argv": [
        "fallow",
        "flags",
        "--no-production"
      ]
    },
    "lsp": {
      "not_expressible": "The language server has no flags command"
    },
    "vscode": {
      "not_expressible": "The editor has no flags input for the language server"
    },
    "node": {
      "not_expressible": "detectFeatureFlags takes production as a bool, and false leaves the config in charge"
    },
    "api": {
      "entry": "feature-flags",
      "options": {
        "production_override": false
      }
    },
    "mcp": {
      "tool": "feature_flags",
      "params": {
        "production": false
      }
    }
  },
  "expected": {
    "surface": "<row>",
    "command": "flags",
    "analyses.dead_code.production": {
      "value": false,
      "source": "given:production"
    }
  },
  "deviations": {
    "cli": {
      "reason": "The CLI names the flag --no-production",
      "expected": {
        "analyses.dead_code.production": {
          "value": false,
          "source": "given:--no-production"
        }
      }
    },
    "api": {
      "reason": "The Rust API names its option analysis.production_override",
      "expected": {
        "analyses.dead_code.production": {
          "value": false,
          "source": "given:analysis.production_override"
        }
      }
    }
  }
}
