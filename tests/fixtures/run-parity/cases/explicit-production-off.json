{
  "name": "explicit-production-off",
  "files": {
    ".fallowrc.json": "{\"production\":true}",
    "package.json": "{}"
  },
  "inputs": {
    "mcp": {
      "tool": "analyze",
      "params": {
        "production": false
      }
    },
    "api": {
      "entry": "dead-code",
      "options": {
        "production_override": false
      }
    },
    "node": {
      "function": "detectDeadCode",
      "options": {
        "production": false
      }
    }
  },
  "expected": {
    "surface": "<row>",
    "command": "dead-code",
    "analyses.dead_code.production": {
      "value": false,
      "source": "given:production"
    }
  },
  "deviations": {
    "api": {
      "reason": "The Rust API names its option analysis.production_override",
      "expected": {
        "analyses.dead_code.production": {
          "value": false,
          "source": "given:analysis.production_override"
        }
      }
    }
  }
}
