{
  "name": "project-info-production-env-off",
  "files": {
    ".fallowrc.json": "{\"production\":true}",
    "package.json": "{}"
  },
  "env": {
    "FALLOW_PRODUCTION": "0"
  },
  "inputs": {
    "mcp": {
      "tool": "project_info",
      "params": {}
    },
    "cli": {
      "argv": [
        "fallow",
        "list"
      ]
    },
    "api": {
      "entry": "list"
    },
    "node": {
      "not_expressible": "The Node bindings have no project info function"
    },
    "lsp": {
      "not_expressible": "The language server has no list command"
    },
    "vscode": {
      "not_expressible": "The editor has no list input for the language server"
    }
  },
  "expected": {
    "surface": "<row>",
    "command": "list",
    "analyses.dead_code.production": {
      "value": true,
      "source": "config-file:production"
    }
  },
  "deviations": {
    "mcp": {
      "reason": "project_info lets a production variable that is off turn production mode off. fallow list and list_boundaries keep the config",
      "expected": {
        "analyses.dead_code.production": {
          "value": false,
          "source": "environment:FALLOW_PRODUCTION"
        }
      }
    }
  }
}
