{
  "name": "node-duplication-production",
  "files": {
    ".fallowrc.json": "{\"production\":{\"dupes\":true}}",
    "package.json": "{}"
  },
  "inputs": {
    "mcp": {
      "not_expressible": "The typed MCP rows of this matrix have no duplication tool"
    },
    "api": {
      "entry": "duplication",
      "options": {
        "no_package_baselines": true
      }
    },
    "node": {
      "function": "detectDuplication",
      "options": {
        "noPackageBaselines": true
      }
    },
    "lsp": {
      "initializationOptions": {
        "packageBaselines": false
      }
    },
    "vscode": {
      "settings": {
        "fallow.packageBaselines": false
      },
      "compare_keys": [
        "packageBaselines"
      ]
    },
    "cli": {
      "argv": [
        "fallow",
        "dupes",
        "--no-package-baselines"
      ]
    }
  },
  "expected": {
    "surface": "<row>",
    "command": "dupes",
    "analyses.duplication.production": {
      "value": true,
      "source": "config-file:production.dupes"
    },
    "settings.package_baselines": {
      "value": false,
      "source": "given:noPackageBaselines"
    }
  },
  "deviations": {
    "api": {
      "reason": "The Rust API names its option analysis.no_package_baselines",
      "expected": {
        "settings.package_baselines": {
          "value": false,
          "source": "given:analysis.no_package_baselines"
        }
      }
    },
    "lsp": {
      "reason": "The language server has one editor command, which plans dead code and duplication. The editor names the setting fallow.packageBaselines",
      "expected": {
        "command": "editor",
        "settings.package_baselines": {
          "value": false,
          "source": "given:fallow.packageBaselines"
        }
      }
    },
    "cli": {
      "reason": "The CLI names the flag --no-package-baselines",
      "expected": {
        "settings.package_baselines": {
          "value": false,
          "source": "given:--no-package-baselines"
        }
      }
    }
  }
}
