{
  "name": "list-boundaries-production-env-off",
  "files": {
    ".fallowrc.json": "{\"production\":true}",
    "package.json": "{}"
  },
  "env": {
    "FALLOW_PRODUCTION": "0"
  },
  "inputs": {
    "mcp": {
      "tool": "list_boundaries",
      "params": {}
    },
    "cli": {
      "argv": [
        "fallow",
        "list",
        "--boundaries"
      ]
    },
    "api": {
      "entry": "list"
    },
    "node": {
      "not_expressible": "The Node bindings have no boundary list function"
