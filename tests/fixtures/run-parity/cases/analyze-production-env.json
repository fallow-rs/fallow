{
  "name": "analyze-production-env",
  "files": {
    "package.json": "{}"
  },
  "env": {
    "FALLOW_PRODUCTION": "1"
  },
  "inputs": {
    "mcp": {
      "tool": "analyze",
      "params": {}
    },
    "cli": {
      "argv": [
        "fallow",
        "dead-code"
      ]
    },
    "api": {
      "entry": "dead-code"
    },
    "node": {
      "function": "detectDeadCode"
    },
    "lsp": {
      "initializationOptions": {}
    },
    "vscode": {
      "settings": {},
      "compare_keys": [
        "production"
      ]
    }
  },
  "expected": {
    "surface": "<row>",
    "command": "dead-code",
    "analyses.dead_code.production": {
      "value": true,
      "source": "environment:FALLOW_PRODUCTION"
    }
  },
  "deviations": {
    "api": {
      "reason": "The Rust API and the Node bindings read no FALLOW_PRODUCTION* variable",
      "expected": {
        "analyses.dead_code.production": {
          "value": false,
          "source": "default:production-off"
        }
      }
    },
    "node": {
      "reason": "The Rust API and the Node bindings read no FALLOW_PRODUCTION* variable",
      "expected": {
        "analyses.dead_code.production": {
          "value": false,
          "source": "default:production-off"
        }
      }
    },
    "lsp": {
      "reason": "The language server has one editor command, which plans dead code and duplication. The language server reads no FALLOW_PRODUCTION* variable",
      "expected": {
        "command": "editor",
        "analyses.dead_code.production": {
          "value": false,
          "source": "default:production-off"
        }
      }
    }
  }
}
