  },
  "invariants": [
    {
      "id": "effective_istanbul_fn_line",
      "rust_fn": "crates/engine/src/health/scoring.rs::effective_istanbul_fn_line",
      "mechanism": "A record's primary alias uses fnMap `line` when the producer set one and falls back to decl.start.line otherwise."
    },
    {
      "id": "body_span_from_entry",
      "rust_fn": "crates/engine/src/health/scoring.rs::IstanbulSpan::from_entry",
      "mechanism": "The body-start alias exists only while loc.start sorts strictly before loc.end, so an inverted span drops the alias instead of matching at a nonsense position."
    },
    {
      "id": "header_from_entry",
      "rust_fn": "crates/engine/src/health/scoring.rs::IstanbulSpan::header_from_entry",
      "mechanism": "The header span runs from decl.start to loc.start, which is what lets a position between the two resolve to the record that encloses it."
    },
    {
      "id": "mark_headers_holding_other_fns",
      "rust_fn": "crates/engine/src/health/scoring.rs::mark_headers_holding_other_fns",
      "mechanism": "A header span that contains a second function's declaration says nothing about the positions inside it, so the header fallback must abstain there."
    },
    {
      "id": "is_anonymous_istanbul_name",
      "rust_fn": "crates/engine/src/health/scoring.rs::is_anonymous_istanbul_name",
      "mechanism": "`(anonymous_N)` records carry no usable name, so they are matched by position rather than by name."
    },
    {
      "id": "named_function_syntax_alias",
      "rust_fn": "crates/engine/src/health/scoring.rs::named_function_syntax_alias",
      "mechanism": "A named function record is anchored at its identifier by some producers and at the `function` keyword by others; the syntax alias reconciles both against the position Fallow extracts."
    },
    {
      "id": "accessor_property_name",
      "rust_fn": "crates/engine/src/health/scoring.rs::accessor_property_name",
      "mechanism": "A record spelled `get area` / `set area` answers to the bare property name Fallow extracts."
    },
    {
      "id": "clamp_negative_positions",
      "rust_fn": "crates/engine/src/health/scoring.rs::parse_coverage_map_tolerantly",
      "mechanism": "A producer that records a negative coordinate for a position it could not place must not reject the whole map, which would silently drop every unit in the file to its static estimate."
    }
  ],
