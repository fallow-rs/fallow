  "fixtures": [
    {
      "id": "plain",
      "file": "fixtures/plain/plain.js",
      "virtual_path": "/fallow/corpus/plain.js",
      "sha256": "0c7ecad8d6d5fed3f4c817a8a5189f87c81268c0c7c47de4deeb487944165295",
      "divergence": "Baseline function declarations. istanbul-lib-instrument anchors decl at the identifier and loc at the body brace, while v8-to-istanbul gives decl and loc the same whole-function span and derives statements per line, so the same probe reports different coverage percentages across the matrix.",
      "invariants": [
        "effective_istanbul_fn_line",
        "body_span_from_entry"
      ]
    },
    {
      "id": "named-fn-expr",
      "file": "fixtures/named-fn-expr/named-fn-expr.js",
      "virtual_path": "/fallow/corpus/named-fn-expr.js",
      "sha256": "9daf54996f3fae51e9d76c40fd3b985e47d2d9c53e6d078fb92bb02c75f2e247",
      "divergence": "Named function expressions. istanbul-lib-instrument anchors decl at the identifier (column 23) while v8-to-istanbul anchors at the `function` keyword (column 14), a nine-column split on one construct, and oxc's default profile names the record after the binding rather than the function.",
      "invariants": [
        "named_function_syntax_alias",
        "is_anonymous_istanbul_name"
      ]
    },
    {
      "id": "curried-arrow",
      "file": "fixtures/curried-arrow/curried-arrow.js",
      "virtual_path": "/fallow/corpus/curried-arrow.js",
      "sha256": "3489dc1f11ca99622ce3ebaf815299fb07a4952978e15b958dad73c96c5e51bb",
      "divergence": "Curried arrows written one per line. An expression-bodied arrow records its body as the next arrow, so record N's loc.start lands exactly on record N+1's decl.start and the matcher has to decide which identity owns the position.",
      "invariants": [
        "mark_headers_holding_other_fns",
        "body_span_from_entry"
      ],
      "fingerprint_collisions": [
        {
          "producers": [
            "istanbul-lib-instrument",
            "ast-v8-to-istanbul",
            "oxc-coverage-instrument",
            "oxc-coverage-instrument-istanbul"
          ],
          "rationale": "An expression-bodied arrow records its body as the enclosing expression, so an outer arrow's loc span contains exactly the inner arrow's statements and every level of a curried chain reports the same executed-over-total ratio. The collision is structural, not an authoring accident: no arrangement of the probe separates the ratios while keeping record N's loc.start on record N+1's decl.start. Identity for this fixture rests on the per-unit resolution status instead, which is what the v8-to-istanbul row measures when it resolves only the outermost arrow."
        }
      ]
    },
    {
      "id": "accessors",
      "file": "fixtures/accessors/accessors.js",
      "virtual_path": "/fallow/corpus/accessors.js",
      "sha256": "15b0ae4a1c3d089b927e83ce387c4acbe89d3c80ece7246ff1e49cd0e46b0a5d",
      "divergence": "Class accessors. The same getter is spelled four ways across the matrix: `(anonymous_N)`, `get area`, `area` and `area_2`, and the two Istanbul-shaped rows disagree by four columns on decl.start.",
      "invariants": [
        "accessor_property_name",
        "is_anonymous_istanbul_name"
      ]
    },
    {
      "id": "one-line",
      "file": "fixtures/one-line/one-line.js",
      "virtual_path": "/fallow/corpus/one-line.js",
      "sha256": "835b370664c5a5283416ba105ee2df4bf6dc4dc9b95a23582186cb442f5b159b",
      "divergence": "Single-line function bodies that end at end of line. ast-v8-to-istanbul reports loc.end.column as Infinity, which serializes to JSON null and deserializes to 0, so the body span of a one-line function inverts. No hand-written fixture would ever express this.",
      "invariants": [
        "body_span_from_entry",
        "header_from_entry"
      ]
    },
    {
      "id": "bare-if",
      "file": "fixtures/bare-if/bare-if.js",
      "virtual_path": "/fallow/corpus/bare-if.js",
      "sha256": "e8d9b4fadd38b6134f8f615580bcc7700631ee9497c3c6dab1cd0bf4954bedb9",
      "divergence": "Bare `if` statements with returning consequents. v8-to-istanbul records `column: -1` for the implicit else it cannot place, and positions are unsigned, so a strict parse rejects the whole map and every unit in the file silently falls back to its static estimate.",
      "invariants": [
        "clamp_negative_positions",
        "effective_istanbul_fn_line"
      ]
    },
    {
      "id": "decorated",
      "file": "fixtures/decorated/decorated.ts",
      "virtual_path": "/fallow/corpus/decorated.ts",
      "sha256": "5ba9c2b28a71c764d377c563a3470f57f20002856661d0d8bf3376431e287278",
      "divergence": "A decorated class member. istanbul-lib-instrument records decl.start at the decorator and loc.start at the body brace, so the position Fallow extracts sits strictly between them and only the header span can resolve it. oxc anchors decl at the method name instead, one line lower.",
      "invariants": [
        "header_from_entry",
        "mark_headers_holding_other_fns"
      ]
    }
  ],
