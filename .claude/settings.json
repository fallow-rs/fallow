{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "root=$(git rev-parse --show-toplevel 2>/dev/null || pwd); python3 \"$root/.claude/hooks/pre-bash-guard.py\"",
            "statusMessage": "Checking fallow agent command guard..."
          },
          {
            "type": "command",
            "command": "if jq -r '.tool_input.command' | grep -q '^git commit'; then staged=$(git diff --cached --name-only --diff-filter=ACMR | sed 's|^|./|'); rs=$(printf '%s\\n' \"$staged\" | grep '\\.rs$' || true); [ -n \"$rs\" ] && printf '%s\\n' \"$rs\" | tr '\\n' '\\0' | xargs -0 rustfmt --edition 2024 2>/dev/null; [ -n \"$staged\" ] && printf '%s\\n' \"$staged\" | tr '\\n' '\\0' | xargs -0 typos; true; fi",
            "statusMessage": "Pre-commit: formatting and typo check..."
          }
        ]
      },
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "root=$(git rev-parse --show-toplevel 2>/dev/null || pwd); node \"$root/scripts/check-comment-quality.mjs\" --claude-pre-tool",
            "statusMessage": "Checking new comments for narration and edit history..."
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 scripts/scan-hidden-unicode.py --mode agent 2>&1 || true",
            "statusMessage": "Scanning agent-instruction files for hidden unicode..."
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "root=$(git rev-parse --show-toplevel 2>/dev/null || pwd); node \"$root/scripts/check-comment-quality.mjs\" --working-tree --claude-hook",
            "statusMessage": "Checking added comments for routine narration..."
          }
        ]
      }
    ]
  },
  "enabledPlugins": {
    "trigger-tree@trigger-tree": true
  },
  "extraKnownMarketplaces": {
    "trigger-tree": {
      "source": {
        "source": "github",
        "repo": "Hedde/trigger_tree",
        "ref": "v1.23.2"
      }
    }
  }
}
